# ─────────────────────────────────────────────────────────────
# ChessChat environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
# Secret used to sign local-mode session cookies (required in every environment).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production
# Set to "false" only when serving over plain HTTP locally (defaults: true in
# production, false in development).
# SESSION_COOKIE_SECURE=false

# AI provider: "gemini" (production) or "mock" (deterministic, tests/dev).
# The mock provider never leaves your machine; CI uses it.
AI_PROVIDER=gemini
# Gemini server-side key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Configurable model name for the Gemini provider.
GEMINI_MODEL=gemini-2.0-flash

# ── Supabase (production path) ───────────────────────────────
# When both URL and service role key are set, the app uses Supabase for
# persistence and Supabase Auth. Otherwise it falls back to the embedded
# local SQLite driver (node:sqlite) — used for local dev, unit tests and e2e.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Local driver ─────────────────────────────────────────────
# Path of the embedded SQLite database (local mode only).
LOCAL_DB_PATH=.localdata/chesschat.db

# Allow POST /api/dev/seed (development fixtures & Playwright resets).
# Must be explicitly enabled; never enable in production.
ENABLE_DEV_SEED=true
